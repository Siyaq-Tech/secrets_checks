# Postgres connection string — Neon, Supabase, or any Postgres works.
DATABASE_URL="postgresql://user:pass@host/db"

# From your GitHub App's settings page (General tab).
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""

# The .pem file GitHub gives you when you generate a private key for the
# App. Paste its full contents here with \n in place of real newlines,
# e.g. "-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END..."
GITHUB_APP_PRIVATE_KEY=""

# From the App's Webhook section — any random string you set there.
GITHUB_APP_WEBHOOK_SECRET=""

# The URL slug of your app, e.g. for github.com/apps/my-config-checker
# this is "my-config-checker" — used to build the install link.
NEXT_PUBLIC_GITHUB_APP_SLUG=""

# Which reusable workflow repo/ref connected repos should call.
SHARED_WORKFLOW_REPO="Siyaq-Tech/secrets_checks"
SHARED_WORKFLOW_REF="main"

# The public URL this app is deployed at (used to build the report
# webhook URL baked into generated caller YAMLs).
PUBLIC_APP_URL="https://your-app.vercel.app"

# Optional — only needed if you want the "email" notification channel to work.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Optional — only needed if you want the "whatsapp" notification channel to
# work. See the WhatsApp caveat in README.md before relying on this.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
